@page "/auth/login"
@layout TransporteWeb.Components.Layout.LoginLayout
@using Blazored.SessionStorage
@using Domain.Dto
@using Domain.Models
@using Microsoft.AspNetCore.Components.Authorization
@using TransporteWeb.Contracts
@using TransporteWeb.Repository.Interfaz
@using TransporteWeb.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ISessionStorageService SessionStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBaseRepository<Cliente,ClienteDto> ClienteService
@inject IDialogService DialogService
@rendermode InteractiveServer


<MudPaper Class="pa-6 rounded-lg border"
          Elevation="4"
          Style="max-width: 450px; margin: auto; border-color: #e0e0e0;">

    <div class="d-flex justify-center mb-6">
        <MudImage Src="TMM.png"
                  Alt="Logo"
                  Width="220"
                  ObjectFit="ObjectFit.Contain" />
    </div>

    <MudForm @ref="_form" @bind-IsValid="@_success" Class="mx-auto" Style="max-width: 340px;">

        <MudTextField T="string"
                      @bind-Value="_item.Username"
                      Label="Email"
                      Required="true"
                      RequiredError="Email es requerido!"
                      Class="mt-3" />

        <MudTextField T="string"
                      @bind-Value="@_item.Password"
                      Label="Password"
                      InputType="InputType.Password"
                      RequiredError="Password is required!"
                      Class="mt-3" />

        <div class="d-flex justify-center mt-6">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@(async () => await Submit())"
                       Size="Size.Large"
                       Class="px-8">
                Ingresar
            </MudButton>
        </div>

    </MudForm>
</MudPaper>
@code {
    private MudForm _form;
    private bool _success;

    private AuthRequest? _item = new AuthRequest();

    List<ClienteDto> clientes = new List<ClienteDto>();

   


    private async Task Submit()
    {
        var authResponse = await AuthService.Login(_item!);
        if (authResponse == null)
        {
            Console.WriteLine("Login falló: credenciales inválidas");
            return;
        }

        await SessionStorage.SetItemAsync("token", authResponse.Token);

        try
        {
            clientes = await ClienteService.GetAllAsync();

            var parameters = new DialogParameters
        {
            { nameof(ClientLoginDialog.Clientes), clientes }
        };

            var dialog = await DialogService.ShowAsync<ClientLoginDialog>("Seleccionar cliente", parameters);
            var result = await dialog.Result;

            if (result == null || result.Canceled)
                return;

            var clienteSeleccionado = (ClienteDto)result.Data!;
            await SessionStorage.SetItemAsync("clienteActual", clienteSeleccionado);

            ((CustomAuthenticationStateProvider)AuthenticationStateProvider).AuthenticateUser(authResponse);

            await Task.Delay(300);

            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en login: {ex.Message}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
        }
    }

        
    
}